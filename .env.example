# PostgreSQL connection string (managed instance)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis connection string (Redis Cloud)
REDIS_URL=redis://default:password@host:6379

# Stripe live API key
STRIPE_API_KEY=sk_live_

# Stripe webhook signing secret (from Stripe dashboard)
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe price IDs
STRIPE_STARTER_PRICE_ID=price_
STRIPE_GROWTH_PRICE_ID=price_

# Redirect URLs
CHECKOUT_SUCCESS_URL=https://your-domain.com/billing/success
CHECKOUT_CANCEL_URL=https://your-domain.com/billing/cancel
PORTAL_RETURN_URL=https://your-domain.com/dashboard
